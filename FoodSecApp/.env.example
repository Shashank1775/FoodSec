# Copy to `.env` (same folder) and fill in what you have. All values are optional.
# Expo inlines EXPO_PUBLIC_* variables into the JS bundle at build time, so restart
# `npx expo start` after editing this file.

# OCR.space API key (free tier: https://ocr.space/ocrapi/freekey).
# Without it the app uses OCR.space's public demo key, which is rate-limited.
EXPO_PUBLIC_OCR_SPACE_API_KEY=

# Optional Azure OpenAI deployment for LLM-based expiry estimates.
# When unset, expiry is estimated from the bundled USDA FoodKeeper dataset.
EXPO_PUBLIC_AZURE_OPENAI_ENDPOINT=
EXPO_PUBLIC_AZURE_OPENAI_KEY=
EXPO_PUBLIC_AZURE_OPENAI_DEPLOYMENT=

# Reserved for a future REST backend (not used yet - persistence is on-device).
EXPO_PUBLIC_API_URL=
